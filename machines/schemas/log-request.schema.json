{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/machines/v1/log-request.schema.json",
  "title": "Log request",
  "description": "The request of log, on the adapter's standard input: the adapter reads the machine's console text and keeps the last part, within 786432 bytes.",
