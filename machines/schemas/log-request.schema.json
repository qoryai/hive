  "additionalProperties": false,
  "required": [
    "version",
    "id"
  ],
  "properties": {
    "version": {
      "$ref": "definitions.schema.json#/$defs/version"
    },
    "id": {
      "$ref": "definitions.schema.json#/$defs/id"
    }
  }
}
