{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qory.dev/contracts/machines/v1/list-answer.schema.json",
  "title": "List answer",
  "description": "The answer of list, on the adapter's standard output, after it exits with status 0: the pool's machines, none or more.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "machines"
  ],
  "properties": {
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "key",
          "state",
          "started"
        ],
        "properties": {
          "id": {
            "$ref": "definitions.schema.json#/$defs/id"
          },
          "key": {
            "$ref": "definitions.schema.json#/$defs/key",
            "description": "The key of the make request that made the machine."
          },
          "state": {
            "$ref": "definitions.schema.json#/$defs/list_state"
          },
          "started": {
            "$ref": "definitions.schema.json#/$defs/started"
          }
        }
      }
    }
  }
}
