#!/bin/bash
# qory-machine-start: the start unit's script, run as root by qory-machine.service at
# boot, once on each machine that the provisioner makes. It reads the start data, drops
# every packet to the instance metadata service, sets up the engine proxy, starts
# docker.service, runs qory run as the user qory in the folder
# /var/lib/qory-machine/work, and powers the machine off when qory run exits, when any
# step fails, or when the machine's lifetime ends.
#
# The machine image must contain bash 5, jq, iptables, ip6tables, runuser (from
# util-linux), systemd (shutdown, systemctl and systemd-notify), and the coreutils
# base64, chmod, chown, head, ls, mkdir, mktemp, mv, rm and tr. It must have the user
# qory.
#
# The script reads the start data from the file /run/qory-machine-start/start-data, and
# deletes the file after the read. A unit for the machine's vendor writes the file
# before this script runs, by the rule in the header of qory-machine.service.
#
# The start data, version 1, is one JSON object, with max_lifetime_minutes an integer
# from 15 to 1470:
#   {"version": 1, "run_code": "qecr_...", "gateway": {"url": "https://host[:port]", "address": "<IPv4 or IPv6>"}, "max_lifetime_minutes": 60}
#
# The run code, the engine proxy password and the start data stay in shell variables and
# pipes. The run code and the password reach no output, no command argument, and no file
# except /run/qory-machine-start/start-data, /run/qory-machine/run-code,
# /etc/docker/daemon.json and /etc/qory/engine-proxy.json. Of the start data, only the
# gateway URL, the address and the lifetime leave the script: the URL in the arguments
# of qory run, the URL's host and the address in /etc/hosts, and the lifetime in the
# arguments of shutdown. Each failure prints one line to stderr; the line starts with
# its fix and contains no secret. When docker.service fails to start, the last 20 lines
# of its journal from this boot go to stderr before that line, each with the password
# replaced by [hidden], and without the lines that contain qak_, qrk_ or qecr_ in any
# case.
#
# At each stage, the script prints one line to stderr:
# "qory-machine-start: <UTC time> <stage>". It prints start data read, firewall set,
# Docker started and run code written as each of those stages ends, and qory run started
# just before it runs qory run. The lines reach the console
# (StandardError=journal+console), so the machine log shows how far the machine got. A
# stage line contains no value of the start data. A stage line that cannot be written
# does not stop the script.
#
# Just before qory run, the script writes the steps of the machine's start to
# /var/lib/qory-machine/steps.jsonl, owner root, mode 0644, and passes the file to qory
# run with --machine-steps-file.
# Each line is one JSON object, in the order the steps ran, with the step's name and its
# start and end in UTC to the millisecond:
#   {"name":"start Docker","started":"2026-11-06T00:31:44.120Z","ended":"2026-11-06T00:31:58.904Z"}
# The steps are boot, read start data, set firewall, start Docker and write run code.
# boot runs from the kernel's start to the script's start. Each other step runs from the
# end of the step before it, or from the script's start when there is no boot line, to
# its stage line. The script reads /proc/uptime at the start of the script and at the
# end of each step, and converts each reading to a UTC time with one reading of the
# clock just before the write, so a change of the clock during the start does not
# reorder the steps. When one of these reads fails or has no number, the script uses
# the clock at each step's end instead, and the file has no boot line. The names come
# from this fixed list, and the file contains no value of the start data.
#
# The script first removes any steps.jsonl, then writes a temporary file in the same
# folder and renames it to steps.jsonl. It writes only when /var/lib/qory-machine is a
# folder, not a link, that root owns and that no group or other user can write. When
# the write fails or is skipped, the script prints one line to stderr that starts with
# the fix, leaves no steps file, and runs qory run without --machine-steps-file. When
# the folder is a link, the script removes and writes no steps file in the folder that
# it links to.
#
# qory run gets QORY_STATUS_FD=3, and descriptor 3 is the script's stderr, so qory run's
# status and error lines reach the console and the machine log. qory run's stdout and
# stderr go to the script's stdout, which reaches the journal only: the output of the
# agent, the setup and the prebuild stays out of the machine log.
#
# qory-machine.service needs systemd 246 or later. From that version, systemd-notify
# waits until systemd has processed READY (a synchronous barrier) before it exits, so
# systemd links READY to this unit under NotifyAccess=all.
#
# QORY_MACHINE_ROOT, when set, is a folder that every path below is placed under. The
# tests set it; qory-machine.service leaves it unset.

set -euo pipefail
umask 077
export LC_ALL=C

root=${QORY_MACHINE_ROOT:-}
data_dir=$root/run/qory-machine-start
data_file=$data_dir/start-data
home=$root/home/qory
urandom=$root/dev/urandom
hosts=$root/etc/hosts
docker_dir=$root/etc/docker
daemon_json=$docker_dir/daemon.json
certs_dir=$docker_dir/certs.d
qory_dir=$root/etc/qory
engine_proxy_json=$qory_dir/engine-proxy.json
run_code_dir=$root/run/qory-machine
run_code_file=$run_code_dir/run-code
state_dir=$root/var/lib/qory-machine
work_dir=$state_dir/work
steps_file=$state_dir/steps.jsonl
uptime_file=$root/proc/uptime

# The steps of the start. A mark is the moment a step ends: the uptime in microseconds
# from /proc/uptime, or "" when the read fails, and the clock in microseconds since
# 1970 UTC. Mark 0 is the script's start, and the step step_names[i] runs from mark i to
# mark i + 1.
step_names=()
mark_uptimes=()
mark_times=()

# read_uptime sets REPLY to the first field of /proc/uptime in microseconds. It returns
# 1 when the read fails or the field is not a number.
read_uptime() {
	local value= rest= fraction
	{ IFS=' ' read -r value rest <"$uptime_file"; } 2>/dev/null || [[ -n $value ]] || return 1
	[[ $value =~ ^([0-9]{1,9})(\.([0-9]{1,6}))?$ ]] || return 1
	fraction=${BASH_REMATCH[3]}000000
	REPLY=$((10#${BASH_REMATCH[1]} * 1000000 + 10#${fraction:0:6}))
}

# mark adds a mark for this moment. In the C locale, EPOCHREALTIME has a dot before its 6
# digits of microseconds.
mark() {
	if read_uptime; then
		mark_uptimes+=("$REPLY")
	else
		mark_uptimes+=("")
	fi
	mark_times+=("${EPOCHREALTIME//[!0-9]/}")
}
mark

# Every exit, after a failure, a signal or the end of qory run, removes the run code,
# the start data file, any temporary file .start-data.* that a killed writer left, and
# any temporary file .steps.jsonl.* of a write that a signal stopped, and powers the
# machine off. When the start data folder or $state_dir is a link, the files in the
# folder it links to stay. steps.jsonl stays: it contains no secret.
on_exit() {
	local status=$?
	set +e
	rm -f -- "$run_code_file" 2>/dev/null
	if [[ ! -L $state_dir ]]; then
		rm -f -- "$state_dir"/.steps.jsonl.* 2>/dev/null
	fi
	if [[ ! -L $data_dir ]]; then
		rm -f -- "$data_file" "$data_dir"/.start-data.* 2>/dev/null
	fi
	if ! systemctl poweroff 2>/dev/null; then
		printf '%s\n' "Power this machine off with systemctl poweroff. The power-off request failed." >&2
	fi
	exit "$status"
}
trap on_exit EXIT
stop() {
	printf '%s\n' "No action needed. The script stopped on $1, and the machine powers off." >&2
	exit "$2"
}
trap 'stop SIGHUP 129' HUP
trap 'stop SIGINT 130' INT
trap 'stop SIGTERM 143' TERM

fail() {
	printf '%s\n' "$1" >&2
	exit 1
}

# stage prints the stage line of $1, a fixed text, with the time in UTC. A failed
# write is ignored.
stage() {
	local time=
	TZ=UTC0 printf -v time '%(%Y-%m-%dT%H:%M:%SZ)T' -1 2>/dev/null || true
	printf '%s\n' "qory-machine-start: $time $1" >&2 2>/dev/null || true
}

# step ends the step $1, a fixed name, at this moment.
step() {
	step_names+=("$1")
	mark
}

# utc sets REPLY to $1, microseconds since 1970, as a UTC time to the millisecond.
utc() {
	local ms=$((($1 % 1000000) / 1000))
	TZ=UTC0 printf -v REPLY '%(%Y-%m-%dT%H:%M:%S)T.%03dZ' "$(($1 / 1000000))" "$ms"
}

# step_line sets REPLY to the line of the step $1 from $2 to $3, in microseconds since
# 1970. The name is from the fixed list, and the times contain only digits and -:.TZ, so
# no character needs escaping.
step_line() {
	local started
	utc "$2"
	started=$REPLY
	utc "$3"
	printf -v REPLY '{"name":"%s","started":"%s","ended":"%s"}\n' "$1" "$started" "$REPLY"
}

# write_steps writes the steps to $steps_file, mode 0644, through a temporary file in
# $state_dir. On failure, it removes the temporary file, leaves no $steps_file, sets
# REPLY to the cause and returns 1. The causes are state, when $state_dir is a link, is
# not a folder, is a folder that another user owns, or is a folder that a group or other
# user can write; folder, when a folder is at $steps_file; and write, when a write fails.
write_steps() {
	local anchor_uptime= anchor_time i text= tmp mode boot=
	local times=()
	if read_uptime; then
		anchor_uptime=$REPLY
	fi
	anchor_time=${EPOCHREALTIME//[!0-9]/}
	# Nothing is removed through a link.
	if [[ -L $state_dir ]]; then
		REPLY=state
		return 1
	fi
	# A steps file from the machine image does not stay after a failure below.
	if ! rm -f -- "$steps_file" 2>/dev/null; then
		if [[ -d $steps_file && ! -L $steps_file ]]; then
			REPLY=folder
		else
			REPLY=write
		fi
		return 1
	fi
	# ls prints the mode first, such as drwxr-xr-x: character 5 is the group's write
	# permission, and character 8 that of other users.
	mode=$(ls -ld -- "$state_dir" 2>/dev/null) || mode=
	if [[ ! -d $state_dir || ! -O $state_dir || ${mode:5:1} != - || ${mode:8:1} != - ]]; then
		REPLY=state
		return 1
	fi

	# The uptime only moves forward, so each mark's time is the clock now minus the
	# uptime since that mark.
	if [[ -n $anchor_uptime ]]; then
		for i in "${!mark_uptimes[@]}"; do
			if [[ -z ${mark_uptimes[i]} ]]; then
				anchor_uptime=
				break
			fi
		done
	fi
	for i in "${!mark_times[@]}"; do
		if [[ -n $anchor_uptime ]]; then
			times+=("$((anchor_time - anchor_uptime + mark_uptimes[i]))")
		else
			times+=("${mark_times[i]}")
		fi
	done
	if [[ -n $anchor_uptime ]] && ((anchor_time >= anchor_uptime)); then
		boot=$((anchor_time - anchor_uptime))
	fi
	if [[ -n $boot ]]; then
		step_line boot "$boot" "${times[0]}"
		text+=$REPLY
	fi
	for i in "${!step_names[@]}"; do
		step_line "${step_names[i]}" "${times[i]}" "${times[i + 1]}"
		text+=$REPLY
	done

	REPLY=write
	tmp=$(mktemp "$state_dir/.steps.jsonl.XXXXXX" 2>/dev/null) || return 1
	# rm also removes a link at $steps_file, so mv replaces no link's target.
	if printf '%s' "$text" 2>/dev/null >"$tmp" &&
		chmod 0644 "$tmp" 2>/dev/null &&
		rm -f -- "$steps_file" 2>/dev/null &&
		mv -f -- "$tmp" "$steps_file" 2>/dev/null; then
		return 0
	fi
	rm -f -- "$tmp" 2>/dev/null
	return 1
}

# docker_log prints the last 20 lines of docker.service's journal from this boot to
# stderr. It replaces each occurrence of the engine proxy password with [hidden], as a
# literal text, and leaves out each line that contains qak_, qrk_ or qecr_ in any case,
# which looks like an access key secret, a run key or a run code. Its failures are
# ignored, and the tool check at the start leaves out journalctl.
docker_log() {
	local line lower
	while IFS= read -r line || [[ -n $line ]]; do
		lower=${line,,}
		if [[ $lower == *qak_* || $lower == *qrk_* || $lower == *qecr_* ]]; then
			continue
		fi
		printf '%s\n' "${line//"$password"/[hidden]}" >&2 2>/dev/null || true
	done < <(journalctl -b -u docker.service -n 20 --no-pager -o cat 2>/dev/null || true)
}

for tool in base64 chmod chown head ip6tables iptables jq ls mkdir mktemp mv rm runuser shutdown systemctl systemd-notify tr; do
	command -v "$tool" >/dev/null || fail "Install $tool in the machine image. This script runs $tool, and it is not on PATH."
done

is_ipv4() {
	local octet='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
	[[ $1 =~ ^$octet\.$octet\.$octet\.$octet$ ]]
}

# count_groups sets REPLY to the number of IPv6 groups in $1, a list of 1 to 4 hex
# digits joined by colons, or returns 1 if $1 is not such a list. An empty $1 has 0.
count_groups() {
	local rest=$1 group n=0
	if [[ -n $rest ]]; then
		while true; do
			group=${rest%%:*}
			[[ $group =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
			n=$((n + 1))
			[[ $rest == *:* ]] || break
			rest=${rest#*:}
		done
	fi
	REPLY=$n
}

is_ipv6() {
	local address=$1 v4 before after
	[[ $address =~ ^[0-9A-Fa-f:.]+$ && $address == *:* ]] || return 1
	if [[ $address == *.* ]]; then
		v4=${address##*:}
		is_ipv4 "$v4" || return 1
		address=${address%"$v4"}0:0
	fi
	[[ $address != *::*::* ]] || return 1
	if [[ $address == *::* ]]; then
		count_groups "${address%%::*}" || return 1
		before=$REPLY
		count_groups "${address#*::}" || return 1
		after=$REPLY
		((before + after <= 7))
	else
		count_groups "$address" || return 1
		((REPLY == 8))
	fi
}

is_hostname() {
	local label='[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
	[[ ${#1} -le 253 && $1 =~ ^($label\.)*$label$ ]]
}

# 1. Read the start data, once. The tests of -e, -d, -f, -O and -s follow a symbolic
# link, so the test of -L comes first. Under qory-machine.service the script runs as
# root, so -O is true for a file or folder that root owns. A missing folder gets the
# line of a missing file.
if [[ -e $data_dir || -L $data_dir ]]; then
	[[ ! -L $data_dir && -d $data_dir && -O $data_dir ]] ||
		fail "Remove $data_dir. The path is a link, not a folder, or a folder that another user owns."
fi
missing="Install the start-data unit for this machine's vendor. $data_file does not exist or is empty."
if [[ -L $data_file ]]; then
	fail "Write the start data to $data_file as a regular file. The path is a symbolic link."
elif [[ ! -e $data_file ]]; then
	fail "$missing"
elif [[ ! -f $data_file ]]; then
	fail "Write the start data to $data_file as a regular file. The path is not a regular file."
elif [[ ! -O $data_file ]]; then
	fail "Write $data_file as root. Another user owns the file."
elif [[ ! -s $data_file ]]; then
	fail "$missing"
fi
{ data=$(<"$data_file"); } 2>/dev/null || fail "Check that root can read $data_file. Reading the file failed."
rm -f -- "$data_file" 2>/dev/null || fail "Check that root can write $data_dir. Removing $data_file failed."

# Valid start data has no backslash. An escape such as \u0073 in a member name would
# give jq a member that the text checks below do not count.
if [[ $data == *'\'* ]]; then
	problem=escape
else
	# The values are printable ASCII without spaces once this check passes, so each one
	# below comes out of jq whole.
	problem=$(printf '%s' "$data" | jq -rs '
		def text: type == "string" and test("\\A[!-~]+\\z");
		if length != 1 or (.[0] | type) != "object" then "json"
		else .[0] |
			if (keys - ["version", "run_code", "gateway", "max_lifetime_minutes"]) != [] then "member"
			elif .version != 1 then "version"
			elif (.run_code | text | not) then "run_code"
			elif (.gateway | type) != "object" then "gateway"
			elif (.gateway | keys - ["url", "address"]) != [] then "member"
			elif (.gateway.url | text | not) then "url"
			elif (.gateway.address | text | not) then "address"
			elif (.max_lifetime_minutes | type) != "number" then "lifetime"
			else "ok" end
		end' 2>/dev/null) || problem=json
fi
url=
address=
run_code=
if [[ $problem == ok ]]; then
	run_code=$(printf '%s' "$data" | jq -rs '.[0].run_code' 2>/dev/null) || problem=json
	url=$(printf '%s' "$data" | jq -rs '.[0].gateway.url' 2>/dev/null) || problem=json
	address=$(printf '%s' "$data" | jq -rs '.[0].gateway.address' 2>/dev/null) || problem=json
fi
# jq reads 1.0, 1e0 and 01 as the number 1, so the text of the start data must contain
# "version" once, followed by the integer 1.
version_text='"version"[[:space:]]*:[[:space:]]*1[[:space:]]*[,}]'
without_version=${data//\"version\"/}
if [[ $problem == ok ]] && { ((${#data} - ${#without_version} != 9)) || ! [[ $data =~ $version_text ]]; }; then
	problem=version
fi
# The same holds for max_lifetime_minutes: once, a plain integer, from 15 to 1470.
lifetime=
lifetime_text='"max_lifetime_minutes"[[:space:]]*:[[:space:]]*([1-9][0-9]{0,3})[[:space:]]*[,}]'
without_lifetime=${data//\"max_lifetime_minutes\"/}
if [[ $problem == ok ]]; then
	if ((${#data} - ${#without_lifetime} == 22)) && [[ $data =~ $lifetime_text ]] &&
		((10#${BASH_REMATCH[1]} >= 15 && 10#${BASH_REMATCH[1]} <= 1470)); then
		lifetime=${BASH_REMATCH[1]}
	else
		problem=lifetime
	fi
fi
unset data without_version without_lifetime
if [[ $problem == ok ]] && ! [[ $run_code =~ ^qecr_[0-9A-HJKMNP-TV-Z]{26}(\.[A-Za-z0-9_-]{22}){1,2}$ ]]; then
	problem=run_code
fi
url_host=
url_port=
if [[ $problem == ok ]]; then
	if [[ $url =~ ^https://([^:/]+)(:([1-9][0-9]{0,4}))?$ ]]; then
		url_host=${BASH_REMATCH[1]}
		url_port=${BASH_REMATCH[3]:-443}
		if ! is_hostname "$url_host" || ((url_port > 65535)); then
			problem=url
		fi
	else
		problem=url
	fi
fi
if [[ $problem == ok ]] && ! is_ipv4 "$address" && ! is_ipv6 "$address"; then
	problem=address
fi
case $problem in
ok) ;;
json) fail "Launch this machine with start data that is one JSON object. The start data is not one JSON object." ;;
escape) fail "Write the start data without a backslash. Valid start data has no escape sequence, and the start data contains a backslash." ;;
member) fail "Remove the unknown members from the start data. Version 1 has only version, run_code, gateway and max_lifetime_minutes, and gateway has only url and address." ;;
version) fail "Set version to 1 in the start data. This script reads only start data version 1." ;;
lifetime) fail "Set max_lifetime_minutes in the start data to an integer from 15 to 1470. The value is missing, out of range or not a plain integer." ;;
run_code) fail "Set run_code in the start data to the run code from Qory Apiary. The value does not have the form qecr_<26 characters>.<22 characters>, with an optional second .<22 characters>." ;;
gateway) fail "Set gateway in the start data to an object with url and address. The gateway value is not an object." ;;
url) fail "Set gateway.url in the start data to https://<host> or https://<host>:<port>. The value has another scheme, a user name, a path or a query, or its host or port is not valid." ;;
address) fail "Set gateway.address in the start data to an IPv4 or IPv6 address. The value is not an IP address." ;;
esac
step "read start data"
stage "start data read"

# 2. Drop every packet whose destination is 169.254.169.254 or fd00:ec2::254 when it
# reaches the raw table, before any nat rule: the OUTPUT rules match the packets that
# this machine's processes send, and the PREROUTING rules match the packets that arrive
# on its interfaces, such as those of containers on a Docker bridge. The raw table runs
# before the nat and filter tables that Docker writes, and these rules go in before
# docker.service starts.
for chain in PREROUTING OUTPUT; do
	iptables -w -t raw -I "$chain" -d 169.254.169.254 -j DROP 2>/dev/null ||
		fail "Check that iptables can add rules to the raw table on this machine image. Adding the $chain rule that drops packets to 169.254.169.254 failed."
	ip6tables -w -t raw -I "$chain" -d fd00:ec2::254 -j DROP 2>/dev/null ||
		fail "Check that ip6tables can add rules to the raw table on this machine image. Adding the $chain rule that drops packets to fd00:ec2::254 failed."
done
step "set firewall"
stage "firewall set"

# 3. The gateway's host name resolves to the address in the start data.
printf '%s %s\n' "$address" "$url_host" 2>/dev/null >>"$hosts" ||
	fail "Check that root can write $hosts. Appending the gateway's line failed."

# The machine powers off max_lifetime_minutes after this step, whatever runs on it.
shutdown -P "+$lifetime" >/dev/null 2>&1 ||
	fail "Check that shutdown -P can schedule a power-off on this machine image. Scheduling the power-off in $lifetime minutes failed."

# 4. The engine proxy: the Docker daemon pulls through 127.0.0.1:3129 with a password of
# 32 random bytes, and qory reads the same address and password from engine-proxy.json.
password=$(head -c 32 "$urandom" 2>/dev/null | base64 2>/dev/null | tr -d '\n=' | tr '+/' '-_') ||
	fail "Check that root can read $urandom. Making the engine proxy password failed."
[[ ${#password} -eq 43 ]] || fail "Check that root can read $urandom. Making the engine proxy password failed."

mkdir -p -m 0755 "$docker_dir" 2>/dev/null || fail "Check that root can write $docker_dir. Making the folder failed."
# The new daemon.json keeps every member of the image's daemon.json and replaces
# proxies. The password and the old content reach jq on stdin, in that order.
daemon_base=
if [[ -e $daemon_json ]]; then
	{ daemon_base=$(<"$daemon_json"); } 2>/dev/null || fail "Check that root can read $daemon_json. Reading it failed."
fi
rm -f -- "$daemon_json" 2>/dev/null || fail "Check that root can write $docker_dir. Removing the old $daemon_json failed."
: 2>/dev/null >"$daemon_json" || fail "Check that root can write $docker_dir. Writing $daemon_json failed."
{ printf '%s\n' "$password"; printf '%s' "$daemon_base"; } | jq -nR '
	input as $password |
	([inputs] | join("\n")) as $base |
	(if ($base | test("\\A\\s*\\z")) then {} else ($base | fromjson) end) |
	if type != "object" then error("not an object") else . end |
	.proxies = {
		"http-proxy": ("http://qory:" + $password + "@127.0.0.1:3129"),
		"https-proxy": ("http://qory:" + $password + "@127.0.0.1:3129"),
		"no-proxy": "localhost,127.0.0.1"
	}' 2>/dev/null >"$daemon_json" ||
	fail "Make $daemon_json in the machine image one JSON object, or remove it. Writing the engine proxy into it failed."
chmod 0600 "$daemon_json" 2>/dev/null || fail "Check that root can write $docker_dir. Setting $daemon_json to mode 0600 failed."

mkdir -p -m 0755 "$qory_dir" 2>/dev/null || fail "Check that root can write $qory_dir. Making the folder failed."
rm -f -- "$engine_proxy_json" 2>/dev/null || fail "Check that root can write $qory_dir. Removing the old $engine_proxy_json failed."
printf '{"version": 1, "address": "127.0.0.1:3129", "password": "%s"}\n' "$password" 2>/dev/null >"$engine_proxy_json" ||
	fail "Check that root can write $qory_dir. Writing $engine_proxy_json failed."
chown qory "$engine_proxy_json" 2>/dev/null || fail "Add the user qory to the machine image. Giving $engine_proxy_json to qory failed."
chmod 0400 "$engine_proxy_json" 2>/dev/null || fail "Check that root can write $qory_dir. Setting $engine_proxy_json to mode 0400 failed."

mkdir -p -m 0755 "$certs_dir" 2>/dev/null || fail "Check that root can write $docker_dir. Making $certs_dir failed."
chown -R qory "$certs_dir" 2>/dev/null || fail "Add the user qory to the machine image. Giving $certs_dir to qory failed."

# docker.service waits for this unit (Before=docker.service in qory-machine.service), so
# the Docker daemon reads the engine proxy from daemon.json when it first starts and
# needs no restart. READY ends that wait (Type=notify, NotifyAccess=all), and
# systemctl start then waits until docker.service is up, before qory runs.
systemd-notify --ready 2>/dev/null || fail "Run this script from qory-machine.service, which has Type=notify. Sending READY to systemd failed."
if ! systemctl start docker.service 2>/dev/null; then
	docker_log
	fail "Read the lines of docker.service above this line in the machine log for the cause. Starting docker.service failed."
fi
# The password stays until here, so docker_log can replace it.
unset password
step "start Docker"
stage "Docker started"
# qory and its children inherit no NOTIFY_SOCKET.
unset NOTIFY_SOCKET

# 5. The run code, for qory only. The folder is given to qory after the file is written.
mkdir -p -m 0700 "$run_code_dir" 2>/dev/null || fail "Check that root can write $root/run. Making $run_code_dir failed."
printf '%s' "$run_code" 2>/dev/null >"$run_code_file" || fail "Check that root can write $run_code_dir. Writing $run_code_file failed."
unset run_code
chmod 0600 "$run_code_file" 2>/dev/null || fail "Check that root can write $run_code_dir. Setting $run_code_file to mode 0600 failed."
chown qory "$run_code_file" "$run_code_dir" 2>/dev/null || fail "Add the user qory to the machine image. Giving $run_code_dir and $run_code_file to qory failed."
step "write run code"
stage "run code written"

# 6. The working folder of qory run, which qory takes as the root of the work. qory run
# exits with an error when the home of its harness, under $home/.cache, is inside that
# folder, so the folder is neither / nor $home, and neither is inside the other once
# their links are resolved. The check runs before chown, which follows links.
mkdir -p -m 0755 "$state_dir" 2>/dev/null || fail "Check that root can write $root/var/lib. Making $state_dir failed."
mkdir -p -m 0700 "$work_dir" 2>/dev/null || fail "Check that root can write $state_dir. Making $work_dir failed."
work_real=$(cd -- "$work_dir" 2>/dev/null && pwd -P) && home_real=$(cd -- "$home" 2>/dev/null && pwd -P) ||
	fail "Check that root can read $work_dir and $home. Resolving their links failed."
if [[ $work_real/ == "${home_real%/}"/* || $home_real/ == "${work_real%/}"/* ]]; then
	fail "Make $work_dir and $home two folders in the machine image, neither inside the other. With links resolved, they are $work_real and $home_real."
fi
chown qory "$work_dir" 2>/dev/null || fail "Add the user qory to the machine image. Giving $work_dir to qory failed."
# runuser without --login keeps the working directory, so qory runs in $work_dir. It
# also keeps QORY_STATUS_FD and passes descriptor 3 on to qory.
cd -- "$work_dir" 2>/dev/null || fail "Check that root can read $work_dir. Changing to the folder failed."

# 7. The steps file, for qory run. A failed write does not stop the script, and qory
# run then starts without --machine-steps-file.
steps_args=()
if write_steps; then
	steps_args=(--machine-steps-file "$steps_file")
else
	case $REPLY in
	state) steps_problem="Make $state_dir a folder, not a link, that root owns and that no group or other user can write. The folder fails this check, so qory run starts without $steps_file." ;;
	folder) steps_problem="Remove the folder $steps_file. A folder is at the path of the steps file, so qory run starts without it." ;;
	*) steps_problem="Check that root can write $state_dir. Writing $steps_file failed, so qory run starts without it." ;;
	esac
	printf '%s\n' "$steps_problem" >&2 2>/dev/null || true
fi

# 8. The run. Its exit powers the machine off, through on_exit.
status=0
stage "qory run started"
HOME=$home QORY_STATUS_FD=3 runuser -u qory -- qory run --run-code-file "$run_code_file" "${steps_args[@]}" --gateway "$url" 3>&2 2>&1 || status=$?
if ((status != 0)); then
	printf '%s\n' "Read the status lines of qory run above this line in the machine log for the cause. qory run exited with status $status." >&2
	exit "$status"
fi
