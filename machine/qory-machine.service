# The start unit of a machine that the provisioner makes. It runs
# /usr/local/libexec/qory/qory-machine-start as root at boot, once. The script sets up the
# Docker daemon's engine proxy before docker.service starts, runs qory run as the user
# qory, and powers the machine off when qory run exits, when any step fails, or when the
# machine's lifetime ends.
#
# Install it as /etc/systemd/system/qory-machine.service, mode 0644, and enable it.
# Install and enable the start-data unit for the image's vendor as well: on EC2,
# qory-machine-data-aws-ec2.service and its script qory-machine-data-aws-ec2.
#
# The start data reaches the script in one file, /run/qory-machine-start/start-data.
# A unit for the machine's vendor writes the file before this unit starts. A unit for
# another vendor, a unit of the instance admin, cloud-init or a step on a bare host can
# write it too. Each writer follows this rule:
#   - Make the folder /run/qory-machine-start as root, mode 0700.
#   - Write the start data to a temporary file in that folder, mode 0600, then rename
#     the file to start-data. On failure, leave no file.
# The script fails on a symbolic link, on a file that is not a regular file, and on a
# file that root does not own. It treats an empty file as missing. It deletes the file
# after the read. No file from an earlier boot remains: /run is a tmpfs, and each
# machine boots once.

[Unit]
Description=Run qory on this machine, then power it off
Wants=network-online.target
After=network-online.target
# docker.service starts after this unit sends READY, so the Docker daemon reads the
# engine proxy from /etc/docker/daemon.json when it first starts.
Before=docker.service
# The machine powers off also when the script is killed and its EXIT trap does not run.
SuccessAction=poweroff
FailureAction=poweroff

[Service]
Type=notify
# systemd-notify, a child of the script, sends READY.
NotifyAccess=all
ExecStart=/usr/local/libexec/qory/qory-machine-start
# Standard error goes to the console as well as the journal, so the vendor's console
# text, which the provisioner uploads as the machine log, contains the script's stage
# lines, its failure line and the status lines of qory run. Standard output goes to the
# journal only; the script sends the rest of qory run's output there.
StandardError=journal+console
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
